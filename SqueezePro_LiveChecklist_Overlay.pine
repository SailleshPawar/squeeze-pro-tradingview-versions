//@version=5
indicator("Squeeze Pro Live Checklist Overlay", shorttitle="Squeeze Live OL", overlay=true)

groupSqueeze = "Squeeze Calculation"
src = input.source(close, "Source", group=groupSqueeze)
length = input.int(20, "Length", minval=1, group=groupSqueeze)
bbMult = input.float(2.0, "Bollinger Multiplier", minval=0.1, step=0.1, group=groupSqueeze)
kcHighMult = input.float(1.0, "KC Multiplier - High Compression", minval=0.1, step=0.1, group=groupSqueeze)
kcMidMult = input.float(1.5, "KC Multiplier - Mid Compression", minval=0.1, step=0.1, group=groupSqueeze)
kcLowMult = input.float(2.0, "KC Multiplier - Low Compression", minval=0.1, step=0.1, group=groupSqueeze)
useTrueRange = input.bool(true, "Use True Range For Keltner Channel", group=groupSqueeze)
triggerBars = input.int(6, "Trigger Threshold (Bars)", minval=1, group=groupSqueeze)
signalMode = input.string("HistAboveBelowZero", "Signal Direction Mode", options=["HistAboveBelowZero", "HistRisingFalling", "HistRisingFromBelowFallingFromAbove"], group=groupSqueeze)

groupTrend = "Trend And Mean"
fastLen = input.int(8, "Fast EMA", minval=1, group=groupTrend)
meanLen = input.int(21, "Mean EMA", minval=1, group=groupTrend)
slowLen = input.int(34, "Slow EMA", minval=1, group=groupTrend)
atrLen = input.int(14, "ATR Length", minval=1, group=groupTrend)
zoneBufferAtr = input.float(0.10, "8/34 Zone Buffer ATR", minval=0.0, step=0.05, group=groupTrend)
extendedAtr = input.float(1.00, "Extended If Distance From 21 EMA > ATR x", minval=0.1, step=0.1, group=groupTrend)

groupDisplay = "Display"
showEmas = input.bool(true, "Show 8/21/34 EMAs", group=groupDisplay)
showAtrBands = input.bool(true, "Show 2 ATR / 3 ATR Bands", group=groupDisplay)
showSqueezeDots = input.bool(true, "Show Squeeze Dots On Price", group=groupDisplay)
showReadyMarkers = input.bool(true, "Show READY Markers", group=groupDisplay)
showFireMarkers = input.bool(true, "Show FIRE Markers", group=groupDisplay)
showStateTable = input.bool(true, "Show Status Table", group=groupDisplay)

groupStyle = "Style"
highCompressionColor = input.color(color.rgb(184, 134, 11), "High Compression Color", group=groupStyle)
midCompressionColor = input.color(color.rgb(139, 0, 0), "Mid Compression Color", group=groupStyle)
lowCompressionColor = input.color(color.rgb(25, 25, 25), "Low Compression Color", group=groupStyle)
releasedColor = input.color(color.rgb(0, 170, 0), "Released Color", group=groupStyle)
emaFastColor = input.color(color.rgb(0, 146, 63), "8 EMA Color", group=groupStyle)
emaMeanColor = input.color(color.rgb(100, 100, 100), "21 EMA Color", group=groupStyle)
emaSlowColor = input.color(color.rgb(128, 0, 0), "34 EMA Color", group=groupStyle)
atr2Color = input.color(color.new(color.teal, 0), "2 ATR Band Color", group=groupStyle)
atr3Color = input.color(color.new(color.blue, 10), "3 ATR Band Color", group=groupStyle)

basis = ta.sma(src, length)
deviation = ta.stdev(src, length) * bbMult
upperBB = basis + deviation
lowerBB = basis - deviation

previousClose = nz(close[1], close)
trueRange = math.max(high - low, math.max(math.abs(high - previousClose), math.abs(low - previousClose)))
rangeValue = useTrueRange ? trueRange : high - low
rangeMA = ta.sma(rangeValue, length)

upperKC(mult) => basis + rangeMA * mult
lowerKC(mult) => basis - rangeMA * mult
insideKC(mult) => upperBB <= upperKC(mult) and lowerBB >= lowerKC(mult)

highCompression = insideKC(kcHighMult)
midCompression = not highCompression and insideKC(kcMidMult)
lowCompression = not highCompression and not midCompression and insideKC(kcLowMult)
level = highCompression ? 3 : midCompression ? 2 : lowCompression ? 1 : 0

highestHigh = ta.highest(high, length)
lowestLow = ta.lowest(low, length)
meanPrice = math.avg(math.avg(highestHigh, lowestLow), ta.sma(close, length))
momentum = ta.linreg(src - meanPrice, length, 0)
histRising = momentum > momentum[1]
histFalling = momentum < momentum[1]
histAboveZero = momentum > 0
histBelowOrEqualZero = momentum <= 0

longBias = switch signalMode
    "HistAboveBelowZero" => histAboveZero
    "HistRisingFalling" => histRising
    => momentum < 0 and histRising

shortBias = switch signalMode
    "HistAboveBelowZero" => histBelowOrEqualZero
    "HistRisingFalling" => histFalling
    => momentum > 0 and histFalling

emaFast = ta.ema(close, fastLen)
emaMean = ta.ema(close, meanLen)
emaSlow = ta.ema(close, slowLen)
atrValue = ta.atr(atrLen)
zoneBuffer = atrValue * zoneBufferAtr

trendLong = emaFast > emaSlow
trendShort = emaFast < emaSlow
fastRising = emaFast > emaFast[1]
slowRising = emaSlow > emaSlow[1]
fastFalling = emaFast < emaFast[1]
slowFalling = emaSlow < emaSlow[1]

priceInLongZone = close <= emaFast + zoneBuffer and close >= emaSlow - zoneBuffer
priceInShortZone = close >= emaFast - zoneBuffer and close <= emaSlow + zoneBuffer
distanceFromMeanAtr = atrValue == 0.0 ? 0.0 : math.abs(close - emaMean) / atrValue
extendedFromMean = distanceFromMeanAtr > extendedAtr

var int squeezeCount = 0
squeezeCount := level > 0 ? nz(squeezeCount[1]) + 1 : 0
signalReady = level > 0 and squeezeCount == triggerBars
launchNow = level == 0 and level[1] > 0

cleanLong = level > 0 and trendLong and fastRising and slowRising and longBias
cleanShort = level > 0 and trendShort and fastFalling and slowFalling and shortBias
longReady = signalReady and cleanLong and priceInLongZone and not extendedFromMean
shortReady = signalReady and cleanShort and priceInShortZone and not extendedFromMean
fireLong = launchNow and trendLong and longBias
fireShort = launchNow and trendShort and shortBias

waitPullbackLong = cleanLong and not priceInLongZone
waitPullbackShort = cleanShort and not priceInShortZone
conflict = level > 0 and not cleanLong and not cleanShort

squeezeColor = releasedColor
if highCompression
    squeezeColor := highCompressionColor
else if midCompression
    squeezeColor := midCompressionColor
else if lowCompression
    squeezeColor := lowCompressionColor

textColorFor(bg) =>
    bg == lowCompressionColor ? color.white : color.black

atrUpper2 = emaMean + atrValue * 2.0
atrLower2 = emaMean - atrValue * 2.0
atrUpper3 = emaMean + atrValue * 3.0
atrLower3 = emaMean - atrValue * 3.0

plot(showEmas ? emaFast : na, "EMA 8", color=emaFastColor, linewidth=2)
plot(showEmas ? emaMean : na, "EMA 21", color=emaMeanColor, linewidth=2)
plot(showEmas ? emaSlow : na, "EMA 34", color=emaSlowColor, linewidth=2)

plot(showAtrBands ? atrUpper2 : na, "21 EMA + 2 ATR", color=atr2Color, linewidth=1)
plot(showAtrBands ? atrLower2 : na, "21 EMA - 2 ATR", color=atr2Color, linewidth=1)
plot(showAtrBands ? atrUpper3 : na, "21 EMA + 3 ATR", color=atr3Color, linewidth=1)
plot(showAtrBands ? atrLower3 : na, "21 EMA - 3 ATR", color=atr3Color, linewidth=1)

plotshape(showSqueezeDots and level > 0, "Squeeze On", style=shape.circle, location=location.belowbar, color=squeezeColor, size=size.tiny)
plotshape(showReadyMarkers and longReady, "Long Ready", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), text="LONG READY", textcolor=color.white, size=size.tiny)
plotshape(showReadyMarkers and shortReady, "Short Ready", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="SHORT READY", textcolor=color.white, size=size.tiny)
plotshape(showFireMarkers and fireLong, "Fire Long", style=shape.labelup, location=location.belowbar, color=squeezeColor, text="FIRE", textcolor=textColorFor(squeezeColor), size=size.small)
plotshape(showFireMarkers and fireShort, "Fire Short", style=shape.labeldown, location=location.abovebar, color=squeezeColor, text="FIRE", textcolor=textColorFor(squeezeColor), size=size.small)

bgcolor(conflict ? color.new(color.orange, 90) : na, title="Conflict Background")

var table statusTable = table.new(position.top_right, 2, 5, border_width=1)

squeezeText = "OFF"
if level == 3
    squeezeText := "HIGH"
else if level == 2
    squeezeText := "MID"
else if level == 1
    squeezeText := "LOW"

trendText = "FLAT"
if trendLong
    trendText := "LONG"
else if trendShort
    trendText := "SHORT"

zoneText = "OUTSIDE"
if extendedFromMean
    zoneText := "EXTENDED"
else if priceInLongZone or priceInShortZone
    zoneText := "IN 8/34"

setupText = "NO SQUEEZE"
if fireLong
    setupText := "FIRE LONG"
else if fireShort
    setupText := "FIRE SHORT"
else if longReady
    setupText := "LONG READY"
else if shortReady
    setupText := "SHORT READY"
else if waitPullbackLong
    setupText := "WAIT PULLBACK LONG"
else if waitPullbackShort
    setupText := "WAIT PULLBACK SHORT"
else if conflict
    setupText := "CONFLICT"
else if level > 0
    setupText := "BUILDING"

targetText = "2 ATR " + str.tostring(atrUpper2, format.mintick) + " / " + str.tostring(atrLower2, format.mintick)

trendCellColor = color.new(color.gray, 40)
if trendLong
    trendCellColor := color.new(color.green, 0)
else if trendShort
    trendCellColor := color.new(color.red, 0)

zoneCellColor = color.new(color.teal, 20)
if extendedFromMean
    zoneCellColor := color.new(color.orange, 0)

setupCellColor = color.new(color.gray, 50)
if fireLong
    setupCellColor := color.new(color.green, 0)
else if fireShort
    setupCellColor := color.new(color.red, 0)
else if longReady
    setupCellColor := color.new(color.green, 10)
else if shortReady
    setupCellColor := color.new(color.red, 10)
else if waitPullbackLong or waitPullbackShort
    setupCellColor := color.new(color.yellow, 10)
else if conflict
    setupCellColor := color.new(color.orange, 0)

if showStateTable and barstate.islast
    table.cell(statusTable, 0, 0, "Squeeze", bgcolor=color.new(color.gray, 25), text_color=color.white)
    table.cell(statusTable, 1, 0, squeezeText, bgcolor=squeezeColor, text_color=textColorFor(squeezeColor))
    table.cell(statusTable, 0, 1, "Trend", bgcolor=color.new(color.gray, 25), text_color=color.white)
    table.cell(statusTable, 1, 1, trendText, bgcolor=trendCellColor, text_color=color.white)
    table.cell(statusTable, 0, 2, "Zone", bgcolor=color.new(color.gray, 25), text_color=color.white)
    table.cell(statusTable, 1, 2, zoneText, bgcolor=zoneCellColor, text_color=color.black)
    table.cell(statusTable, 0, 3, "Setup", bgcolor=color.new(color.gray, 25), text_color=color.white)
    table.cell(statusTable, 1, 3, setupText, bgcolor=setupCellColor, text_color=color.black)
    table.cell(statusTable, 0, 4, "2 ATR", bgcolor=color.new(color.gray, 25), text_color=color.white)
    table.cell(statusTable, 1, 4, targetText, bgcolor=color.new(color.blue, 85), text_color=color.white)

alertcondition(longReady, "Squeeze Live Long Ready", "Long checklist is aligned")
alertcondition(shortReady, "Squeeze Live Short Ready", "Short checklist is aligned")
alertcondition(fireLong, "Squeeze Live Fire Long", "Squeeze released with long alignment")
alertcondition(fireShort, "Squeeze Live Fire Short", "Squeeze released with short alignment")
alertcondition(waitPullbackLong or waitPullbackShort, "Squeeze Live Wait Pullback", "Checklist is aligned but price is extended from the preferred zone")
